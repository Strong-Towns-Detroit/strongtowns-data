{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "krabby:promotion-pointer:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["pointer_contract_version", "asset_id", "snapshot_id", "manifest_path", "manifest_sha256", "promoted_at"],
  "properties": {
    "pointer_contract_version": {"const": "1.0.0"},
    "asset_id": {"type": "string"},
    "snapshot_id": {"type": "string"},
    "manifest_path": {"type": "string"},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "promoted_at": {"type": "string", "format": "date-time"}
  }
}
